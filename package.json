{
  "name": "md-ast-parser",
  "version": "0.3.0",
  "description": "High-performance Markdown to AST parser optimized for WYSIWYG usage.",
  "keywords": [
    "markdown",
    "markdown-parser",
    "parser",
    "ast",
    "ast-parser",
    "syntax-tree",
    "syntax-highlighting",
    "shiki",
    "typescript",
    "wysiwyg"
  ],
  "homepage": "https://github.com/vavoya/md-ast-parser#readme",
  "bugs": {
    "url": "https://github.com/vavoya/md-ast-parser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vavoya/md-ast-parser.git"
  },
  "license": "MIT",
  "author": "vavoya",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --watch",
    "test": "tsx --test src/tests/*.test.ts",
    "bench": "tsx src/tests/performance-benchmark.test.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "lru-cache": "^11.1.0",
    "shiki": "^3.2.1"
  }
}
